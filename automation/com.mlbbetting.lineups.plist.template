<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mlbbetting.lineups</string>
    <!-- Second pass at 15:30 local: confirmed lineups are usually posted by
         now for evening games, so props get lineup K% and any new prop lines.
         Already-logged bets are skipped (idempotent), only new ones added. -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__PROJECT__/paper_trade/update_and_pick.py</string>
        <string>--log-bets</string>
        <string>--skip-refresh</string>
        <string>--skip-retrain</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>15</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__PROJECT__/logs/lineups.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT__/logs/lineups.log</string>
</dict>
</plist>
